        "jsonOutput": "={{ (() => { const saved=$('Store restricted admin grant').first().json; const expected=$('Prepare restricted admin grant').first().json; const hash=$('Hash admin token').first().json.tokenHash; if(!saved.id||saved.tokenHash!==hash||saved.clientRecordId!=='__portal_admin__'||saved.scope!=='portal:admin'||Date.parse(saved.expiresAt)!==Date.parse(expected.expiresAt)||saved.revokedAt!==null) throw new Error('admin_grant_persistence_failed'); return {token:$('Encode URL-safe admin token').first().json.token,expiresAt:expected.expiresAt,grantId:saved.id,scope:'portal:admin'}; })() }}",
