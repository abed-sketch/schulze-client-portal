# Public, build-time configuration. HTTPS base, including /webhook if using n8n directly.
# Do not include /customer-portal/bootstrap here. Never put credentials in VITE_*.
VITE_API_BASE_URL=
# Public Supabase configuration used only for generic realtime invalidation events.
# The publishable key is safe for browser use; never place a Supabase secret/service-role key here.
VITE_SUPABASE_URL=https://zwtmlrzwqnluosrdbjfv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OZuJ4MY2fQDjbmgEnzQ_Eg_ux5stSq0
# Server runtime configuration: comma-separated exact HTTPS origins (no trailing slash).
# Empty FRAME_ANCESTORS denies iframe embedding until the verified LS origin is set.
FRAME_ANCESTORS=
# Origin only of VITE_API_BASE_URL, for the browser's connect-src policy.
API_ORIGIN=
PORT=8080
